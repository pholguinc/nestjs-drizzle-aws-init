# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_123
DB_NAME=notary_db

# Internal configuration for PostgreSQL container
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}

# Dynamic Connection String for Drizzle/ORM
DATABASE_URL=postgresql://postgres:postgres_secure_password_123@localhost:5432/notary_db

# ==============================================================================
# Cache & Session Configuration (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_456
